---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectPost from '../components/ProjectPost.astro';
const allPosts = Object.values(import.meta.glob('./projects/*.md', { eager: true}))
const pageTitle = "Projects"
---

<BaseLayout pageTitle={pageTitle}>
    <ul>
       {allPosts.map((post: any) => <ProjectPost url={post.url} title={post.frontmatter.title} />)}
    </ul>
</BaseLayout>

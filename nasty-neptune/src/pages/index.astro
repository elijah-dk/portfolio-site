import BaseLayout from '../layouts/BaseLayout.astro';
import astroLogo from '../assets/astro.svg';
import '../styles/global.css';

const pageTitle = "Home page"
const identity = {
  firstName: "Name",
  state: "State",
  hobbies: ["linux", " computer building/repair", " 3D art"],
};

const skills = ["Active directory", "Virtualization", "Troubleshooting", "Scripting", "Bash", "Powershell"];
const skillColor = "crimson";
const fontWeight = "bold";
const textCase = "upperCase"
---

<BaseLayout pageTitle={pageTitle}>

        <style define:vars={{skillColor, fontWeight, textCase}}>
        h1{
            color: purple;
            font-size: 4rem;
        }
        .skill{
            color: var(--skillColor);
            font-weight: var(--fontWeight);
        }
    </style>
    
    <div>
        <ul>
            <li>{identity.firstName}</li>

            <img src={astroLogo.src} width="115" height="48" alt="Astro Homepage" />
            <li>{identity.state}</li>
              {identity.hobbies.length >= 3 &&
    <li>Three of my hobbies are: {identity.hobbies[0]} and {identity.hobbies[1]} and {identity.hobbies[2]}</li>}
        </ul>
        <p>I'm familar with:</p>
<ul>
  {skills.map((skill) => <li class="skill">{skill}</li>)}
</ul>
    </div>
</BaseLayout>